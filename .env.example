# Get these from https://my.telegram.org -> API Development Tools
# These two identify your APPLICATION, not your account -- they stay the
# same across every login and never change.
TG_API_ID=
TG_API_HASH=

# OPTIONAL. If set, the app starts already logged in. If left blank, use
# the in-app login panel (phone -> code -> optional 2FA) after starting the
# server -- it fills this in for you at runtime and remembers it in
# ./data/runtime_config.json for same-machine restarts.
TG_SESSION_STRING=

# OPTIONAL. Numeric id of the private channel used as storage. If left
# blank, pick it from the "storage channel" step of the login panel after
# logging in.
TG_STORAGE_CHAT_ID=

# Required. Shared admin secret -- gates uploads AND the login panel, so
# random visitors to your deployed URL can't trigger a login attempt on
# your phone number or upload files. Set this to something private before
# deploying anywhere public.
UPLOAD_SECRET=

# Where SQLite metadata + the saved session config live
DATA_DIR=./data
